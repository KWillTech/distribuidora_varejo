# Copie este arquivo para .env e ajuste para o seu ambiente.
APP_NAME=Adega do Bruninho
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_DIR=logs

# Use o IP do servidor MongoDB para os demais computadores da rede local.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=distribuidora_varejo
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=1
MONGODB_TLS=false

# Opcional. Se vazio, uma senha temporária forte será gerada e exibida uma vez.
INITIAL_ADMIN_PASSWORD=
